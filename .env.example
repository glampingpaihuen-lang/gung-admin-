# Copia este archivo como .env.local y llena los valores.

# Código para entrar al panel. Sin esto, en el PC el código de prueba es 1234.
CODIGO_PANEL=

# Supabase (los mismos en nube-app). Vacíos = modo de prueba en el PC (carpeta ../.datos).
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Dirección de la página pública, para los botones «Ver la página» y «Copiar enlace».
# En el PC: http://localhost:3050 · Publicada: por ejemplo https://fotos.gungho.com
NEXT_PUBLIC_URL_NUBE=http://localhost:3050
