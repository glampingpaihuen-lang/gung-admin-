# Copia este archivo como .env.local y llena los valores.

# Código para entrar al panel. Sin esto, en el PC el código de prueba es 1234.
CODIGO_PANEL=

# Supabase: la lista de empresas, fotos y ajustes (los mismos en nube-app).
# Vacíos = modo de prueba en el PC (carpeta ../.datos).
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Cloudflare R2: donde quedan las fotos y videos (10 GB gratis, descargas sin costo, videos pesados).
# Sin esto, los archivos se guardan en Supabase (máximo 50 MB por archivo en el plan gratis).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=gung-ho-fotos
R2_PUBLIC_URL=

# Dirección de la página pública, para los botones «Ver la página» y «Copiar enlace».
NEXT_PUBLIC_URL_NUBE=http://localhost:3050
